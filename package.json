    "e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.js",
    "qr": "node scripts/qr.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "qrcode": "^1.5.4"
  }
}
