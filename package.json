{
  "name": "um-carinho-de-volta",
  "version": "1.0.0",
  "private": true,
  "description": "Um carinho de volta — quem recebe um presente da Tetê Atelier Sucré grava um agradecimento e envia para quem presenteou.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
